---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DeerLogo from '../components/DeerLogo.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-bg text-cream">
    <Header />

    <!-- ══════════════════ CINEMATIC HERO ══════════════════ -->
    <section class="relative h-screen min-h-[640px] overflow-hidden">

      <!-- Photo bg — swap this div for <Image> when ready -->
      <div
        class="hero-photo-bg absolute inset-0"
        role="img"
        aria-label="Photo of Kevin and Simča"
      >
        <span class="absolute bottom-4 right-6 text-[0.58rem] tracking-[0.22em] uppercase text-cream/[7%] pointer-events-none select-none">
          add photo here
        </span>
      </div>

      <!-- Cinematic overlay — clear centre, heavy bottom fade -->
      <div class="hero-overlay absolute inset-0 pointer-events-none"></div>

      <!-- ── LOWER THIRD ── -->
      <div class="absolute bottom-0 left-0 right-0 z-[2] pb-14">
        <div class="max-w-[1200px] mx-auto px-8 flex flex-col items-center text-center gap-0">

          <!-- Identity: deer + text, fully centred -->
          <div
            class="flex flex-col items-center gap-5 opacity-0 [animation:fadeInUp_0.9s_ease_0.4s_forwards]"
          >
            <div class="deer-glow">
              <DeerLogo size={110} />
            </div>
            <div class="flex flex-col items-center">
              <h1
                class="font-display font-bold tracking-[0.18em] leading-none text-cream mb-3"
                style="font-size: clamp(2.4rem, 5.5vw, 4.8rem)"
              >DAŇKOVI</h1>
              <span class="block w-10 h-px bg-gold mb-3"></span>
              <p class="font-display italic text-[1rem] text-cream/68 mb-[0.3rem]">
                <em>Kevin &amp; Simča</em>
              </p>
              <p class="text-[0.7rem] tracking-[0.14em] uppercase text-cream/38 m-0">
                Where code meets creativity
              </p>
            </div>
          </div>

          <!-- Scroll cue -->
          <div
            class="flex flex-col items-center gap-2 mt-6 opacity-0 [animation:fadeIn_1s_ease_1.1s_forwards]"
          >
            <div class="w-px h-8 bg-gradient-to-b from-gold to-transparent [animation:scrollPulse_2.4s_ease-in-out_1.4s_infinite]"></div>
          </div>

        </div>
      </div>

    </section>

    <!-- ══════════════════════ PEOPLE ══════════════════════ -->
    <section class="py-28">
      <div class="max-w-[1200px] mx-auto px-8">

        <header class="mb-16">
          <p class="section-label">The family</p>
          <h2
            class="font-display font-normal text-cream mt-[0.4rem] leading-[1.25]"
            style="font-size: clamp(2rem, 4vw, 3rem)"
          >Two worlds,<br /><em class="italic text-gold">one home.</em></h2>
          <span class="gold-rule"></span>
        </header>

        <div class="grid grid-cols-1 gap-16 md:grid-cols-2 md:gap-14">

          <!-- Kevin -->
          <article class="group flex flex-col">
            <a
              href="/kevin"
              class="photo-placeholder relative aspect-[4/5] w-full block rounded-sm mb-7 overflow-hidden transition-transform duration-500 group-hover:scale-[1.015] cursor-pointer"
              tabindex="-1"
              aria-hidden="true"
            >
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <DeerLogo size={120} class="opacity-[10%]" />
              </div>
              <div class="absolute bottom-5 left-5 w-11 h-11 border border-gold flex items-center justify-center">
                <span class="font-display text-[1.1rem] text-gold leading-none">K</span>
              </div>
            </a>
            <div class="flex flex-col">
              <p class="section-label mb-2">Software Engineer</p>
              <h3 class="font-display text-[1.9rem] font-semibold text-cream mb-1">Kevin Daněk</h3>
              <span class="gold-rule"></span>
              <p class="text-muted text-[0.93rem] leading-[1.75] mb-6">
                Building robust systems and elegant interfaces. Passionate about open-source,
                clean architecture, and the craft of software engineering.
              </p>
              <a
                href="/kevin"
                class="inline-flex items-center gap-[0.4rem] text-[0.78rem] tracking-[0.14em] uppercase text-cream no-underline border-b border-gold pb-[0.2rem] w-fit transition-[color,gap] duration-200 hover:text-gold hover:gap-[0.7rem]"
              >Meet Kevin <span>→</span></a>
            </div>
          </article>

          <!-- Simča -->
          <article class="group flex flex-col">
            <a
              href="/simca"
              class="photo-placeholder relative aspect-[4/5] w-full block rounded-sm mb-7 overflow-hidden transition-transform duration-500 group-hover:scale-[1.015] cursor-pointer"
              tabindex="-1"
              aria-hidden="true"
            >
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <DeerLogo size={120} class="opacity-[10%]" />
              </div>
              <div class="absolute bottom-5 left-5 w-11 h-11 border border-gold flex items-center justify-center">
                <span class="font-display text-[1.1rem] text-gold leading-none">S</span>
              </div>
            </a>
            <div class="flex flex-col">
              <p class="section-label mb-2">Creative Teaching</p>
              <h3 class="font-display text-[1.9rem] font-semibold text-cream mb-1">Simča Daňková</h3>
              <span class="gold-rule"></span>
              <p class="text-muted text-[0.93rem] leading-[1.75] mb-6">
                Weaving art, imagination, and curiosity into every lesson. Helping young
                minds discover their own creative voice and potential.
              </p>
              <a
                href="/simca"
                class="inline-flex items-center gap-[0.4rem] text-[0.78rem] tracking-[0.14em] uppercase text-cream no-underline border-b border-gold pb-[0.2rem] w-fit transition-[color,gap] duration-200 hover:text-gold hover:gap-[0.7rem]"
              >Meet Simča <span>→</span></a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- ════════════════════ BLOG TEASER ════════════════════ -->
    {posts.length > 0 && (
      <section class="py-28 bg-bg-2 border-t border-cream/[7%]">
        <div class="max-w-[1200px] mx-auto px-8">

          <header class="mb-12 text-right">
            <p class="section-label">Writing</p>
            <h2
              class="font-display font-normal text-cream mt-[0.4rem] leading-[1.25]"
              style="font-size: clamp(2rem, 4vw, 3rem)"
            >Latest from<br /><em class="italic text-gold">the journal.</em></h2>
            <span class="gold-rule ml-auto mr-0"></span>
          </header>

          <div class="grid grid-cols-1 gap-7 mb-12 lg:grid-cols-3">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group/card flex flex-col p-7 border border-cream/[7%] rounded-sm bg-surface text-cream no-underline transition-[border-color,transform,background] duration-300 hover:border-gold hover:-translate-y-1 hover:bg-surface-2"
              >
                <time class="text-[0.68rem] tracking-[0.18em] uppercase text-gold mb-[0.85rem]" datetime={post.data.pubDate.toISOString()}>
                  <FormattedDate date={post.data.pubDate} />
                </time>
                <h3 class="font-display text-[1.15rem] font-semibold text-cream leading-[1.35] mb-3">{post.data.title}</h3>
                <p class="text-[0.87rem] text-muted leading-[1.65] flex-1 mb-5">{post.data.description}</p>
                <span class="text-[0.72rem] tracking-[0.14em] uppercase text-gold self-start">Read →</span>
              </a>
            ))}
          </div>

          <div class="flex justify-end">
            <a
              href="/blog"
              class="text-[0.78rem] tracking-[0.14em] uppercase text-cream no-underline border-b border-gold pb-[0.2rem] transition-colors duration-200 hover:text-gold"
            >All posts →</a>
          </div>

        </div>
      </section>
    )}

    <Footer />
  </body>
</html>
