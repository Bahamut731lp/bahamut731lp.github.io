---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-bg text-cream">
    <Header />

    <main class="pt-[72px] min-h-screen pb-24">
      <div class="max-w-[1200px] mx-auto px-8">

        <header class="pt-20 pb-14">
          <p class="section-label">Writing</p>
          <h1
            class="font-display font-bold text-cream mt-[0.4rem]"
            style="font-size: clamp(2.5rem, 6vw, 4.5rem)"
          >The Journal</h1>
          <span class="gold-rule"></span>
          <p class="text-base text-muted m-0 max-w-[480px]">Stories, thoughts, and notes from two worlds.</p>
        </header>

        <ul class="list-none p-0 m-0 grid grid-cols-1 gap-8 md:grid-cols-2">
          {posts.map((post, i) => (
            <li class:list={[i === 0 && 'md:col-span-2']}>
              <a
                href={`/blog/${post.id}/`}
                class:list={[
                  'group flex bg-surface border border-cream/[7%] rounded-sm overflow-hidden text-cream no-underline h-full transition-[border-color,transform] duration-300 hover:border-gold hover:-translate-y-1',
                  i === 0 ? 'flex-row' : 'flex-col',
                ]}
              >
                {post.data.heroImage && (
                  <div class:list={[
                    'overflow-hidden flex-shrink-0',
                    i === 0 ? 'w-[55%] min-h-[320px]' : 'w-full aspect-[16/9]',
                  ]}>
                    <Image
                      width={i === 0 ? 1200 : 720}
                      height={i === 0 ? 500 : 360}
                      src={post.data.heroImage}
                      alt=""
                      class="w-full h-full object-cover rounded-none m-0 transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class:list={[
                  'flex flex-col flex-1',
                  i === 0 ? 'p-10' : 'p-6',
                ]}>
                  <time class="text-[0.68rem] tracking-[0.18em] uppercase text-gold mb-3" datetime={post.data.pubDate.toISOString()}>
                    <FormattedDate date={post.data.pubDate} />
                  </time>
                  <h2 class:list={[
                    'font-display font-semibold text-cream leading-[1.3] mb-3',
                    i === 0 ? 'text-[2rem]' : 'text-[1.25rem]',
                  ]}>{post.data.title}</h2>
                  <p class="text-[0.87rem] text-muted leading-[1.65] flex-1 mb-5">{post.data.description}</p>
                  <span class="text-[0.72rem] tracking-[0.14em] uppercase text-gold self-start">Read →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>

      </div>
    </main>

    <Footer />
  </body>
</html>
