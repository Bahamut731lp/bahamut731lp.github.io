---
import DeerLogo from './DeerLogo.astro';
const year = new Date().getFullYear();
---

<footer class="py-16 px-8 bg-bg-2 border-t border-gold/[18%]">
  <div class="max-w-[1200px] mx-auto flex flex-col items-center gap-6">

    <a href="/" class="block transition-opacity duration-200 hover:opacity-70" aria-label="Daňkovi — home">
      <DeerLogo size={44} />
    </a>

    <nav class="flex items-center gap-3" aria-label="Footer navigation">
      {(['/', '/kevin', '/simca', '/blog'] as const).map((href, i) => (
        <>
          {i > 0 && <span class="text-gold/[18%]" aria-hidden="true">·</span>}
          <a
            href={href}
            class="text-xs tracking-[0.16em] uppercase text-muted no-underline transition-colors duration-200 hover:text-gold"
          >
            {href === '/' ? 'Home' : href === '/kevin' ? 'Kevin' : href === '/simca' ? 'Simča' : 'Blog'}
          </a>
        </>
      ))}
    </nav>

    <p class="text-[0.72rem] tracking-[0.1em] text-muted opacity-60 m-0">© {year} Daňkovi</p>
  </div>
</footer>
