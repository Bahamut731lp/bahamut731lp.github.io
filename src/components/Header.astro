---
import DeerLogo from './DeerLogo.astro';
import { SITE_TITLE } from '../consts';

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/',      label: 'Home' },
  { href: '/kevin', label: 'Kevin' },
  { href: '/simca', label: 'Simča' },
  { href: '/blog',  label: 'Blog' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-[100] border-b border-transparent">
  <div class="max-w-[1200px] mx-auto px-8 h-[72px] flex items-center justify-between">

    <a
      href="/"
      class="flex items-center gap-[0.65rem] text-cream no-underline transition-colors duration-200 hover:text-gold"
      aria-label={`${SITE_TITLE} — home`}
    >
      <DeerLogo size={34} class="flex-shrink-0" />
      <span class="font-display text-[1.15rem] tracking-[0.04em]">{SITE_TITLE}</span>
    </a>

    <nav class="flex items-center gap-9" aria-label="Main navigation">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'nav-link text-[0.78rem] tracking-[0.16em] uppercase no-underline transition-colors duration-200',
            isActive(href) ? 'active text-cream' : 'text-muted hover:text-cream',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 60);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
